{
  "name": "onestep-chat",
  "main": "worker.js",
  "workers_dev": true,
  "observability": { "enabled": true },
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onestep-chat",
      "database_id": "cb57e12f-b63c-476d-9421-2f43b54293b6"
    }
  ],
  "vars": {
    "AI_ENABLED": "true",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}